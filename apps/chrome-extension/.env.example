# Cliente OAuth do tipo Chrome Extension criado no Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Chave PUBLICA da extensão para manter o mesmo ID em builds descompactadas.
# Não coloque aqui a chave privada usada para empacotar/publicar a extensão.
CHROME_EXTENSION_PUBLIC_KEY=cole-a-chave-publica-base64-aqui
