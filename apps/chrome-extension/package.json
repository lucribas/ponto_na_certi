{
  "name": "ponto-na-certi-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"site/**/*.{html,css}\" \"*.{json,ts,md}\"",
    "test:unit": "vitest run --project unit",
    "test:parity": "vitest run --project parity",
    "test:integration": "vitest run --project integration",
    "test:authenticated": "vitest run --project authenticated",
    "test:authenticated:headless-flow": "node scripts/authenticated-headless-flow.mjs",
    "test:chrome-headless": "npm run build && node scripts/chrome-headless-regression.mjs",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:parity && npm run test:integration && npm run test:e2e",
    "build": "vite build && node scripts/verify-build.mjs",
    "e2e:install": "playwright install chromium",
    "package": "npm run build && node scripts/package.mjs",
    "release:site": "npm run package && node scripts/build-release-site.mjs",
    "convert:rag": "node scripts/convert-rag.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/archiver": "8.0.0",
    "@types/chrome": "0.2.7",
    "@types/node": "26.2.0",
    "archiver": "7.0.1",
    "eslint": "10.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ical.js": "^2.2.1"
  }
}
